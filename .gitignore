# Generated by Cargo
# will have compiled files and executables
debug/
target/
# Cargo.lock IS committed: this workspace ships a binary, and the lockfile's exact
# versions + checksums are the supply-chain pin that `--locked` CI builds enforce.
# Release pipeline output (content-tool pack → dist/package.flk). Never inside
# Alpha/content/ — a stray package.flk there would auto-mount over the loose dev tree.
dist/
# These are backup files generated by rustfmt
**/*.rs.bk
# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# MacOS File Metadata
.DS_Store

/Alpha/content/source
/Alpha/content/staging

# Tier-3 player config — runtime-written, per-user, never committed
settings.json

__pycache__/
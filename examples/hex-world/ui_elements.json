    "stats": {
      "x": 16,
      "title": { "y": 14, "size": 20, "color": [1.0, 1.0, 1.0, 1.0] },
      "cam":   { "y": 40, "size": 15, "color": [0.72, 0.84, 0.96, 1.0] },
      "sel":   { "y": 60, "size": 15, "color": [0.96, 0.86, 0.60, 1.0] },
      "sim":   { "y": 80, "size": 15, "color": [0.62, 0.95, 0.72, 1.0] },
      "view":  { "y": 100, "size": 15, "color": [0.78, 0.80, 0.98, 1.0] }
    },

    "checkboxes": {
      "origin": [16, 152],
      "row_h": 26,
      "box": 18,
      "header": { "text": "VIEW / SIM — click to toggle", "size": 15, "color": [0.85, 0.85, 0.7, 1.0] },
      "border_color": [1.0, 1.0, 1.0, 1.0],
      "fill_on": [0.30, 0.62, 0.95, 1.0],
      "fill_off": [0.15, 0.15, 0.18, 1.0],

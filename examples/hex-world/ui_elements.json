      "label_size": 14,
      "label_color": [0.78, 0.81, 0.86, 1.0],
      "speed": { "label": "Sim speed", "min": 0.0, "max": 4.0, "w": 150, "h": 12 },
      "reset": { "label": "Reset camera", "w": 150, "h": 24 },
      "view": { "label": "View", "options": ["World", "Local"], "w": 120, "h": 20 },

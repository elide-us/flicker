{
  "format": "flicker.pack",
  "version": 1,
  "_note": "Authored combat/movement state graph for the Katanami base character. Separate from flicker.rig (which stays a mechanical FBX-derived atom). Clip names are the rig's clip stems; event/window ticks are within each clip's duration_ticks. TAE events are fired/reported by the runtime; hitbox capsules + i-frame invulnerability are wired in a later slice.",
  "state_machine": {
    "initial": "Idle",

    "default_blend_ticks": 6,

    "any": [
      { "to": "Dame_01", "on": "hit", "priority": 100, "blend_ticks": 2 },
      { "to": "Death_01", "on": "die", "priority": 200, "blend_ticks": 2 }
    ],

    "states": [
      {
        "name": "Idle",
        "clip": "Idle_nonWeapon",
        "transitions": [
          { "to": "Attack_1", "on": "attack", "priority": 5 },
          { "to": "Jump_Start", "on": "jump", "priority": 5 },
          { "to": "Crouch", "on": "crouch", "priority": 3 },
          { "to": "Walk", "on": "move", "priority": 1 }
        ]
      },
      {
        "name": "Walk",
        "clip": "Walk_nonWeapon",
        "events": [
          { "tick": 8, "kind": "footstep", "label": "L" },
          { "tick": 40, "kind": "footstep", "label": "R" }
        ],
        "transitions": [
          { "to": "Attack_1", "on": "attack", "priority": 5 },
          { "to": "Jump_Start", "on": "jump", "priority": 5 },
          { "to": "Crouch", "on": "crouch", "priority": 3 },
          { "to": "Run", "on": "run", "priority": 2 },
          { "to": "Idle", "on": "move_stop", "priority": 1 }
        ]
      },
      {
        "name": "Run",
        "clip": "Run_nonWeapon",
        "events": [
          { "tick": 6, "kind": "footstep", "label": "L" },
          { "tick": 36, "kind": "footstep", "label": "R" }
        ],
        "transitions": [
          { "to": "Jump_Start", "on": "jump", "priority": 5 },
          { "to": "Attack_1", "on": "attack", "priority": 5 },
          { "to": "Idle", "on": "move_stop", "priority": 3 },
          { "to": "Walk", "on": "run_stop", "priority": 1 }
        ]
      },
      {
        "name": "Crouch",
        "clip": "Crouch",
        "transitions": [
          { "to": "Crouch_Move", "on": "move", "priority": 2 },
          { "to": "Idle", "on": "crouch_stop", "priority": 1 }
        ]
      },
      {
        "name": "Crouch_Move",
        "clip": "Crouch_Move_F",
        "events": [
          { "tick": 12, "kind": "footstep", "label": "L" },
          { "tick": 45, "kind": "footstep", "label": "R" }
        ],
        "transitions": [
          { "to": "Walk", "on": "crouch_stop", "priority": 2 },
          { "to": "Crouch", "on": "move_stop", "priority": 1 }
        ]
      },
      {
        "name": "Jump_Start",
        "clip": "Jump_Start",
        "looping": false,
        "next": "Jump_Loop",
        "events": [
          { "tick": 6, "kind": "sfx", "label": "liftoff" }
        ]
      },
      {
        "name": "Jump_Loop",
        "clip": "Jump_Loop",
        "transitions": [
          { "to": "Jump_End", "on": "clip_done", "priority": 1 }
        ]
      },
      {
        "name": "Jump_End",
        "clip": "Jump_End",
        "looping": false,
        "next": "Idle",
        "events": [
          { "tick": 2, "kind": "footstep", "label": "land" }
        ]
      },
      {
        "name": "Attack_1",
        "clip": "Attack_1",
        "looping": false,
        "events": [
          { "tick": 12, "kind": "sfx", "label": "swing" },
          { "tick": 15, "end": 30, "kind": "hitbox_active", "label": "Weapon_R" },
          { "tick": 15, "end": 30, "kind": "weapon_trail", "label": "blade" },
          { "tick": 40, "end": 55, "kind": "cancel_window", "label": "combo" }
        ],
        "transitions": [
          { "to": "Attack_1", "on": "attack", "window": { "start": 40, "end": 55 }, "priority": 10 },
          { "to": "Idle", "on": "clip_done", "priority": 1 }
        ]
      },
      {
        "name": "Dame_01",
        "clip": "Dame_01",
        "looping": false,
        "next": "Idle"
      },
      {
        "name": "Death_01",
        "clip": "Death_01",
        "looping": false
      }
    ]
  }
}

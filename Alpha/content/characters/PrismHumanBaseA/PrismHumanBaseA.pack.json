{
  "format": "flicker.pack",
  "version": 1,
  "_note": "Locomotion state graph for PrismHumanBaseA, driving the retargeted Motifect clip library (Alpha/content/retarget/clips — In-Place bare stems, so it plays on a treadmill). tick_rate_hz is 60 — the golden-spec time canon (memory 302BBB85): the Motifect clips are now baked at 60 Hz (source 30 fps upsampled x2 by tools/retarget_bvh.py, source frames kept verbatim on the even ticks), so they play at correct speed under the state machine's 60 Hz clock. Directional walk/run/crouch are discrete strafe/back states gated by move_left/right/back/forward — a stand-in for a 2D locomotion blend space, mirroring Katanami.pack.json. Combat (Attack/Dame/Death) + TAE footstep/hitbox events are deferred: those clips live in the Motifect combat pack, not yet retargeted.",
  "state_machine": {
    "initial": "Idle",
    "tick_rate_hz": 60,
    "default_blend_ticks": 6,

    "states": [
      {
        "name": "Idle",
        "clip": "idle_neutral",
        "transitions": [
          { "to": "Jump", "on": "jump", "priority": 5 },
          { "to": "Crouch", "on": "crouch", "priority": 4 },
          { "to": "Walk_L", "on": "move_left", "priority": 2 },
          { "to": "Walk_R", "on": "move_right", "priority": 2 },
          { "to": "Walk_B", "on": "move_back", "priority": 2 },
          { "to": "Walk", "on": "move", "priority": 1 }
        ]
      },

      {
        "name": "Walk",
        "clip": "walk_forward",
        "transitions": [
          { "to": "Jump", "on": "jump", "priority": 5 },
          { "to": "Crouch", "on": "crouch", "priority": 4 },
          { "to": "Run", "on": "run", "priority": 3 },
          { "to": "Walk_L", "on": "move_left", "priority": 2 },
          { "to": "Walk_R", "on": "move_right", "priority": 2 },
          { "to": "Walk_B", "on": "move_back", "priority": 2 },
          { "to": "Idle", "on": "move_stop", "priority": 1 }
        ]
      },
      {
        "name": "Walk_L",
        "clip": "walk_strafe_left",

      "margin_b": 18,
      "panel_bg": [0.05, 0.06, 0.09, 0.94],
      "panel_border": [0.26, 0.34, 0.5, 1.0],
      "label_size": 12,
      "cell": { "cell": [0.11, 0.14, 0.2, 0.97], "hot": [0.22, 0.42, 0.3, 1.0], "label": [0.82, 0.86, 0.92, 1.0], "label_size": 12 },

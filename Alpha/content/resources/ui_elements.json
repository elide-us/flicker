  "_modal_comment": "Prism carved-stone modal, drawn (not baked): the shared style for the main menu / pause 'Sanctum' / display-confirm, all rendered by modal.lua from `screens.<Model.screen>`. Chrome = `panel` HudCommands (rounded-rect + 2-stop gradient + border + soft drop-shadow); buttons pick a `variant` (primary sapphire / secondary stone / danger rust). The panel auto-sizes to its content, so a screen just lists its title/subtitle/items. Sizes are px; every colour a `$token`.",
  "modal": {
    "panel": {
      "w": 404,
      "pad_x": 38,
      "pad_top": 34,
      "pad_bottom": 30,
      "radius": 5,
      "border_w": 1,
      "fill_top": "$stone3",
      "fill_bot": "$stone1",
      "border": "$edge2",
      "shadow": "$shadow",
      "shadow_dy": 20,
      "shadow_feather": 44,
      "shadow_grow": 4
    },
    "title": { "size": 52, "color": "$ink_bright", "glow": "$sap_glow" },
    "subtitle": { "size": 11, "color": "$bronze_dim", "gap_top": 12 },
    "countdown": { "size": 15, "color": "$dim", "gap_top": 10 },
    "divider": { "color": "$bronze", "gap": 22 },
    "footer": { "size": 10, "color": "$faint", "gap_top": 14 },
    "studio": { "size": 9, "color": "$studio", "margin_x": 0, "margin_b": 34 },
    "spectrum": { "w": 4, "alpha": 0.55, "palette": [
      "$sig_white", "$sig_yellow", "$sig_red", "$sig_orange", "$sig_black_gem", "$sig_blue", "$sig_green"
    ] },
    "buttons": {
      "h": 48,
      "gap": 12,
      "gap_top": 22,
      "radius": 3,
      "border_w": 1,
      "label_size": 15,
      "variants": {
        "primary": {
          "fill_top": "$sap_base", "fill_bot": "$sap_base_lo", "border": "$sap_border", "label": "$ink_sapphire",
          "glow": "$sap_glow",
          "hover_top": "$sap_hover", "hover_bot": "$sap_hover_lo", "hover_border": "$sap_hover_border", "hover_label": "$ink_sapphire"
        },
        "secondary": {
          "fill_top": "$stone_btn", "fill_bot": "$stone2", "border": "$edge4", "label": "$ink_button",
          "hover_top": "$stone_btn_hi", "hover_bot": "$surface_top", "hover_border": "$bronze_dim", "hover_label": "$ink_bright"
        },
        "danger": {
          "fill_top": "$stone_btn", "fill_bot": "$stone2", "border": "$danger_border", "label": "$danger_text",
          "hover_top": "$danger_bg", "hover_bot": "$danger_bg_lo", "hover_border": "$danger_hi", "hover_label": "$danger_text_hi"
        }
      }
    }
  },

  "screens": {
    "menu": {
      "layout": "left",
      "bg_top": "$stone3",
      "bg_bot": "$stone0",
      "scrim": "$stone0",
      "muse": true,
      "spectrum": true,
      "studio": "ELIDEUS PRODUCTIONS · CLAY ENGINE",
      "title": "Prism",
      "title_size": 58,
      "subtitle": "THE SEVEN SHARDS",
      "items": [
        { "id": "start", "label": "ENTER WORLD", "variant": "primary" },
        { "id": "character", "label": "CHARACTER SELECT", "variant": "secondary" },
        { "id": "settings", "label": "SETTINGS", "variant": "secondary" },
        { "id": "quit", "label": "QUIT", "variant": "danger" }
      ]
    },
    "pause": {
      "layout": "center",
      "overlay": "$scrim",
      "title": "Sanctum",
      "title_size": 46,
      "subtitle": "GATHER YOURSELF · THE WORLD RUNS ON",
      "footer": "ESC TO RETURN",
      "items": [
        { "id": "resume", "label": "RETURN TO WORLD", "variant": "primary" },
        { "id": "settings", "label": "SETTINGS", "variant": "secondary" },
        { "id": "quit", "label": "QUIT", "variant": "danger" }
      ]
    },
    "confirm": {
      "layout": "center",
      "overlay": "$scrim_dim",
      "title": "Keep Display?",
      "title_size": 38,
      "items": [
        { "id": "keep", "label": "KEEP", "variant": "primary" },
        { "id": "revert", "label": "REVERT", "variant": "danger" }
      ]
    }
  },

  "_settings_comment": "Prism Settings 'workbench' (settings.lua): a resizable window (capped to the viewport) = title bar + left category rail (Video/Audio/Input, each keyed to a Septisigil gem) + right scrolling content + footer (Restore / Back / Apply). Chrome + controls are VECTOR `panel` commands. Controls carry `wired`: true = bound to the shell settings/input backend, false = an inert layout preview (FOV, brightness, edge-pan, all of Audio, the controller device — no engine behind them yet). Every colour is a $token.",
  "settings": {
    "window": {
      "w": 1180, "h": 726, "min_margin": 32, "radius": 4,
      "fill_top": "$stone3", "fill_bot": "$stone1", "border": "$edge2",
      "shadow": "$shadow", "shadow_dy": 18, "shadow_feather": 46, "shadow_grow": 4
    },
    "runes": { "size": 5, "inset": 12, "top": "$rune_glow", "bot": "$bronze_dim" },
    "titlebar": {
      "h": 52, "pad_x": 30, "wash": "$accent_wash", "seam": "$seam",
      "mark": "$bronze", "title": "Settings", "title_size": 24, "title_color": "$ink_bright",
      "hint": "ESC TO CLOSE", "hint_size": 9, "hint_color": "$faint",
      "close": { "size": 26, "radius": 3, "bg": "$danger_bg", "border": "$danger_border", "label": "$danger_text", "hover_border": "$danger_hi", "hover_label": "$danger_text_hi" }
    },
    "nav": {
      "w": 236, "pad": 16, "seam": "$seam",
      "header": "CATEGORIES", "header_size": 9, "header_color": "$faint",
      "row_h": 42, "gap": 5, "gem": 9, "label_size": 13,
      "active_top": "$accent_wash_2", "active_bot": "$accent_wash", "active_border": "$rune_glow", "active_label": "$ink_bright",
      "inactive_label": "$dim",
      "footer_title": "PRISM · CLAY ENGINE", "footer_title_color": "$bronze_dim",
      "footer_sub": "Adventurer & RTS shared kit", "footer_sub_color": "$faint"
    },
    "content": {
      "pad_x": 34, "pad_top": 22, "kicker_size": 10, "title_size": 32, "title_color": "$ink_bright", "seam": "$seam", "scrollbar": "$bronze_dim"
    },
    "footer": {
      "h": 58, "pad_x": 34, "seam": "$seam",
      "restore": "RESTORE DEFAULTS", "restore_color": "$muted", "restore_hover": "$danger_hi",
      "applied": "SETTINGS APPLIED", "applied_color": "$rune_glow_hi",
      "back": "BACK", "apply": "APPLY"
    },
    "row": {
      "h": 50, "group_gap": 22, "seam": "$row_line",
      "name_size": 17, "name_color": "$ink_label",
      "desc_size": 13, "desc_color": "$dim_soft",
      "group_size": 10, "group_color": "$bronze",
      "ctrl_w": 340, "value_size": 13, "value_color": "$rune_glow_hi"
    },
    "controls": {
      "field": { "top": "$surface_top", "bot": "$surface_bot", "border": "$edge4", "hover_border": "$bronze_dim", "radius": 3, "h": 40, "label": "$ink_button", "label_size": 15, "caret": "$rune_glow" },
      "menu": { "top": "$stone3", "bot": "$stone0", "border": "$edge2", "radius": 3, "row_h": 30, "label": "$ink_button", "label_size": 15, "sel_bg": "$accent_wash_2", "sel_label": "$ink_bright", "hover_bg": "$accent_wash" },
      "segment": { "bg": "$well", "border": "$edge2", "radius": 4, "pad": 3, "h": 36, "active_top": "$sap_base", "active_bot": "$sap_base_lo", "active_label": "$ink_sapphire", "label": "$dim", "label_size": 11 },
      "toggle": { "w": 50, "h": 25, "on_top": "$sap_base", "on_bot": "$sap_base_lo", "on_border": "$sap_border", "off_bg": "$stone2", "off_border": "$edge3", "knob_on": "$ink_sapphire", "knob_off": "$dim" },
      "cycler": { "w": 200, "h": 40, "btn_top": "$surface_top", "btn_bot": "$surface_bot", "btn_hover": "$stone_btn_hi", "btn_border": "$edge4", "arrow": "$bronze", "mid": "$well", "label": "$ink_bright", "label_size": 13 },
      "slider": { "track": "$well", "border": "$edge2", "fill_lo": "$sap_base_lo", "fill_hi": "$sap_border", "knob_top": "$stone4", "knob_bot": "$stone2", "knob_border": "$sap_border", "knob_dot": "$rune_glow", "h": 8, "knob": 20 },
      "keycap": {
        "w": 156, "h": 34, "radius": 3, "label_size": 12,
        "top": "$stone_btn", "bot": "$stone2", "border": "$edge4", "label": "$ink_bright",
        "rebind_top": "$sap_hover", "rebind_bot": "$sap_hover_lo", "rebind_border": "$rune_glow", "rebind_label": "$ink_sapphire",
        "unbound_bg": "$surface_bot", "unbound_border": "$seam", "unbound_label": "$faint"
      },
      "pill": { "bg": "$well", "border": "$edge2", "radius": 15, "pad": 3, "h": 30, "active_top": "$sap_base", "active_bot": "$sap_base_lo", "active_label": "$ink_sapphire", "label": "$dim", "label_size": 11 }
    },
    "rebind_banner": {
      "top": "$accent_wash_2", "bot": "$accent_wash", "border": "$sap_border",
      "text": "Press any key to bind", "text2": "Esc to cancel · Backspace to unbind",
      "text_color": "$ink_label", "accent": "$rune_glow_hi", "hint_color": "$dim_soft"
    },
    "nav_items": [

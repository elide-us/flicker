      "panel_border": "$bronze_dim",
      "label_size": 13,
      "label_color": "$ink",
      "value_size": 12,
      "value_color": "$dim",
      "slider": { "track": "$stone1", "fill": "$sap_base", "fill_hi": "$sap_border", "handle": "$sap_border", "handle_w": 9 },
      "_focus_note": "Click a slider to FOCUS it; ←/→ then nudge it by `nudge` (hold Shift for `nudge_coarse`). A trackpad drag over a ~120px track spans the whole range, which is far too coarse to fit a piece by eye — the arrows are the fine control. The focused row is drawn with `focus_*`. SCALE IS PER-AXIS (sx/sy/sz): a garment generated separately from the body is rarely the same build, so a uniform scale can line it up but never make it fit. Scale and offset are both in WORLD axes at rest (x lateral, y depth, z up), NOT bone axes — the fit cancels the socket rest rotation, so x thickens sideways whichever bone the piece hangs off.",
      "focus_track": "$stone3",
      "focus_fill": "$rune_glow",
      "focus_label": "$rune_glow_hi",
      "uniform": { "min": 0.1, "max": 200.0, "nudge": 0.1, "nudge_coarse": 1.0 },
      "scale": { "min": 0.25, "max": 4.0, "nudge": 0.01, "nudge_coarse": 0.1 },

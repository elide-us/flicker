{
  "_comment": "Sablework Bench SCENE DEFINITION (201F4F51 template-free). The texture SYNTHESIZER console: LEFT the 6-voice channel rack (each voice row is authored DATA — arrangement, not a template), CENTRE the tiled-swatch preview under an 8-tab view selector (7 flat maps + the LIT turntable; the tabs bind `sel_map`, a NUMBER), RIGHT the output stage over the selected voice's fine knobs. Header: material dropdown (Rust-filled from the index, binds `sel_material`) + patch stepper + Roll/Reseed. Footer: bake rung · Commit · status. The `sablework` behaviour plays it (flicker-sablework); sablework.lua derives the row washes + view-cell visibility. Styles were folded in from the crate's quarantined scene_styles.json (its layout block described the deleted workbench template and did not move).",
  "behaviour": "sablework",
  "params": {},
  "styles": {
    "window": {
      "_comment": "This bench's root slab — scene-owned like populous's (a shared file would fork the look; duplication is the pattern). Only draw-read keys: no dead w/h.",
      "radius": 4,
      "fill_top": "$stone3",
      "fill_bot": "$stone1",
      "border": "$edge2",
      "shadow": "$shadow",
      "shadow_dy": 18,
      "shadow_feather": 46,
      "shadow_grow": 4
    },
    "sablework": {
      "col": {
        "label": "$dim_soft",
        "title": "$ink_bright",
        "value": "$ink",
        "dim": "$dim",
        "accent": "$rune_glow_hi",
        "bronze": "$bronze",
        "bronze_deep": "$bronze_deep",
        "off": "$faint"
      },
      "panel": {
        "fill_top": "$stone3",
        "fill_bot": "$stone1",
        "border": "$edge2",
        "border_w": 1,
        "radius": 4,
        "focused": {
          "fill_top": "$stone4",
          "fill_bot": "$stone2",
          "border": "$sap_border",
          "border_w": 1,
          "radius": 4
        }
      },
      "well": {
        "fill_top": "$stone0",
        "fill_bot": "$stone0",
        "border": "$edge3",
        "border_w": 1,
        "radius": 3
      },
      "frame": {
        "fill_top": [0, 0, 0, 0],
        "fill_bot": [0, 0, 0, 0],
        "border": "$bronze_deep",
        "border_w": 1,
        "radius": 3
      },
      "row": {
        "fill_top": "$stone2",
        "fill_bot": "$stone1",
        "border": "$edge1",
        "border_w": 1,
        "radius": 3,
        "focused": {
          "fill_top": "$stone3",
          "fill_bot": "$stone1",
          "border": "$sap_border",
          "border_w": 1,
          "radius": 3
        }
      },
      "row_sel": {
        "fill_top": "$stone4",
        "fill_bot": "$stone2",
        "border": "$sap_border",
        "border_w": 1,
        "radius": 3,
        "focused": {
          "fill_top": "$stone4",
          "fill_bot": "$stone2",
          "border": "$sap_hover_border",
          "border_w": 1,
          "radius": 3
        }
      },
      "checkbox": {
        "box": "$stone2",
        "check": "$sig_green",
        "border": "$edge4",
        "pad": 3
      },
      "slider": {
        "track": "$well",
        "border": "$edge2",
        "fill": "$sap_base",
        "fill_hi": "$sap_border",
        "handle": "$sap_border",
        "handle_w": 14
      },
      "button": {
        "fill_top": "$stone4",
        "fill_bot": "$stone2",
        "border": "$edge3",
        "border_w": 1,
        "radius": 3
      },
      "button_on": {
        "fill_top": "$sap_hover",
        "fill_bot": "$sap_base",
        "border": "$sap_border",
        "border_w": 1,
        "radius": 3
      },
      "select": {
        "_comment": "The material binding dropdown (header). `field` = the closed control; `menu` = the open popup rows. Options are Rust-filled from the material index (label_bind per row), so the names ride the Model bind channel, not raw tree literals.",
        "field": { "top": "$stone4", "bot": "$stone2", "border": "$edge3", "hover_border": "$sap_border", "radius": 3, "label": "$ink", "label_size": 13, "caret": "$bronze" },
        "menu": { "top": "$stone3", "bot": "$stone0", "border": "$edge2", "radius": 3, "row_h": 26, "label": "$ink", "label_size": 13, "sel_bg": "$sap_base", "sel_label": "$ink_bright", "hover_bg": "$sap_hover" }
      },
      "bar": {
        "_comment": "Header/footer band — a subtly raised slab so the top + bottom rows read as bars distinct from the body panels (UX pass may refine).",
        "fill_top": "$stone4",
        "fill_bot": "$stone3",
        "border": "$edge2",
        "border_w": 1,
        "radius": 3
      },
      "preview": {
        "_comment": "`tiles` = how many times the scene repeats the baked swatch per axis BEFORE uploading, so the seam shows in one sprite. Read by the Rust scene when it creates the preview textures.",
        "tiles": 3
      }
    },
    "nav_footer": {
      "_comment": "Bench nav rail band (like the Component Catalog's). `frame` = the node's own slab; `rule` (top hairline) + `label` (legend ink) + the `pad_glyphs` atlas resolve as the component's defaults.",
      "frame": { "fill_top": "$surface_top", "fill_bot": "$stage_void", "border": "$edge2", "border_w": 1, "radius": 6 },
      "rule": { "color": "$seam" },
      "label": "$dim"
    },
    "pad_glyphs": {
      "tex": 2, "cols": 4, "rows": 4, "color": "$bronze", "flash": "$rune_glow_hi",
      "cells": { "lt": 0, "rt": 1, "lb": 2, "rb": 3, "a": 4, "b": 5, "x": 6, "y": 7, "menu": 8, "view": 9, "dpad": 10, "dpad_up": 11, "dpad_down": 12, "dpad_left": 13, "dpad_right": 14, "stick": 15 }
    }
  },

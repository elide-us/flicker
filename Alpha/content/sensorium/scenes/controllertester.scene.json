{
  "_comment": "Controller Tester SCENE DEFINITION (201F4F51 template-free; ruling DC217431). The live input-BUS inspector: this tree is the scene CHROME ONLY — the header block, the mouse readout, and the CONTEXT TAB BAR as real walker buttons (style_bind washes; the declared on_tab_* intents cycle the same ring). Everything below the chrome is the sanctioned SUB-SIGNAL diagnostic feed, scene-drawn by the behaviour from the raw device snapshot: the controller diagram, the analog latch, the golem stage, and the three bus panels (context stack · focus chain · consumed-this-frame) reporting the DEMO resolver/router exhibit. The `controllertester` behaviour plays it (flicker-controllertester); controllertester.lua composes the status/mouse readouts and picks the tab washes from the raw state.",
  "behaviour": "controllertester",
  "params": {},
  "styles": {
    "controllertester": {
      "title": {
        "color": "$rune_glow"
      },
      "dim": {
        "color": "$dim"
      },
      "ok": "$sig_green",
      "off": "$dim",
      "tab_active": {
        "fill_top": "$accent_wash_2",
        "fill_bot": "$accent_wash_2",
        "border": "$bronze",
        "border_w": 2,
        "label": "$ink_bright",
        "radius": 4
      },
      "tab_idle": {
        "fill_top": "$stage_void",
        "fill_bot": "$stage_void",
        "border": "$stage_void",
        "border_w": 0,
        "label": "$dim",
        "radius": 4
      }
    }
  },
  "tree": {
    "component": "surface",
    "id": "controllertester",
    "on_menu": "pause_open",
    "on_tab_next": "ctx_next",
    "on_tab_prev": "ctx_prev",
    "children": [
      {
        "component": "cell",
        "id": "ctt_header",
        "anchor": "top_left",
        "offset": [18, 12],
        "width": 960,
        "gap": 0,
        "children": [
          { "component": "text", "text": "$ctt_title", "size": 26, "text_size": 20, "color": "controllertester.title.color" },
          { "component": "text", "text": "$ctt_hint", "size": 18, "text_size": 12, "color": "controllertester.dim.color" },
          { "component": "text", "text_bind": "status", "size": 16, "text_size": 12, "color_bind": "status_color" }
        ]
      },
      {
        "component": "cell",
        "id": "ctt_mouse",
        "anchor": "top_right",
        "offset": [-18, 16],
        "width": 230,
        "children": [
          { "component": "text", "text_bind": "mouse_line", "size": 16, "text_size": 12, "align": "right", "color": "controllertester.dim.color" }
        ]
      },
      {
        "component": "row",
        "id": "ctt_tabs",
        "anchor": "top_left",
        "offset": [40, 86],
        "width": 680,
        "size": 28,
        "gap": 0,
        "align": "center",
        "children": [
          { "component": "button", "id": "ctt_tab_world", "action": "ctx_world", "label": "$ctt_ctx_world", "style_bind": "ctx_world_style", "grow": 1.0, "size_class": "sm", "tab_group": "ctt_tabs", "nav_ordinal": 1 },
          { "component": "button", "id": "ctt_tab_menu", "action": "ctx_menu", "label": "$ctt_ctx_menu", "style_bind": "ctx_menu_style", "grow": 1.0, "size_class": "sm", "tab_group": "ctt_tabs", "nav_ordinal": 2 },
          { "component": "button", "id": "ctt_tab_radial", "action": "ctx_radial", "label": "$ctt_ctx_radial", "style_bind": "ctx_radial_style", "grow": 1.0, "size_class": "sm", "tab_group": "ctt_tabs", "nav_ordinal": 3 },
          { "component": "button", "id": "ctt_tab_textentry", "action": "ctx_textentry", "label": "$ctt_ctx_textentry", "style_bind": "ctx_textentry_style", "grow": 1.0, "size_class": "sm", "tab_group": "ctt_tabs", "nav_ordinal": 4 }
        ]
      }
    ]
  }
}

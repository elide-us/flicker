{
  "_comment": "Populous bench SCENE DEFINITION (201F4F51 template-free). Same form as ClickTrainer/SolarBirth: a behaviour + a tree of primitive component KINDS + exits, authored as data. The bench owns + loads its own scene file (the shell manifest is for shell scenes); populous.lua orchestrates + the globe draws in the rtt pane. Retires the invented populous.tree.json (1F151933).",
  "behaviour": "populous",
  "params": {},
  "tree": {
    "component": "screen",
    "id": "populous",
    "on_menu": "pause_open",
    "on_page_next": "page_next",
    "on_page_prev": "page_prev",
    "on_tab_next": "tab_next",
    "on_tab_prev": "tab_prev",
    "children": [
      {
        "component": "stack",
        "style": "settings.window",
        "anchor": "top_left",
        "width_frac": 1.0,
        "height_frac": 1.0,
        "children": [
          {
            "component": "cell",
            "anchor": "top_left",
            "width_frac": 1.0,
            "height_frac": 1.0,
            "pad": 30,
            "children": [
              {
                "component": "paged_menu",
                "style": "paged_menu.frame",
                "pad": 40,
                "grow": 1.0,
                "children": [
                  {
                    "component": "tabs",
                    "id": "paged_pages",
                    "bind": "page",
                    "next_action": "page_next",
                    "prev_action": "page_prev",
                    "grow": 1.0,
                    "gap": 8,
                    "tab_active": "paged_menu.page_active",
                    "tab_idle": "paged_menu.page_idle",
                    "children": [
                      {
                        "component": "option",
                        "value": 0,
                        "label": "$pop_page_world"
                      }
                    ]
                  },
                  {
                    "component": "pill_toggle",
                    "id": "paged_tabs",
                    "bind": "tab",
                    "next_action": "tab_next",
                    "prev_action": "tab_prev",
                    "size": 520,
                    "style": "paged_menu.tab_track",
                    "tab_active": "paged_menu.tab_active",
                    "tab_idle": "paged_menu.tab_idle",
                    "children": [
                      {
                        "component": "option",
                        "value": 0,
                        "label": "$pop_tab_map"
                      },
                      {
                        "component": "option",
                        "value": 1,
                        "label": "$pop_tab_seams"
                      }
                    ]
                  },
                  {
                    "component": "cell",
                    "style": "settings.window",
                    "grow": 1.0,
                    "pad": 30,
                    "children": [
                      {
                        "component": "row",
                        "grow": 1.0,
                        "gap": 10,
                        "children": [
                          {
                            "component": "panel",
                            "id": "pop_left",
                            "style": "panel",
                            "tab_group": "pop_left",
                            "nav_ordinal": 0,
                            "pad": 10,
                            "grow": 0.7,
                            "children": [
                              {
                                "component": "cell",
                                "visible_bind": "shown_p0_t0",
                                "grow": 1.0,
                                "children": [
                                  {
                                    "component": "slider",
                                    "id": "pop_freq",
                                    "style": "slider",
                                    "bind": "pop_freq",
                                    "label": "$pop_size",
                                    "vertical": true,
                                    "min": 48,
                                    "max": 120,
                                    "step": 1,
                                    "step_coarse": 10,
                                    "decimals": 0,
                                    "slider_h": 10,
                                    "value_w": 44,
                                    "grow": 1.0,
                                    "tab_group": "pop_left",
                                    "nav_ordinal": 1
                                  }
                                ]
                              },
                              {
                                "component": "cell",
                                "visible_bind": "shown_p0_t1",
                                "grow": 1.0,
                                "children": [
                                  {
                                    "component": "button",
                                    "action": "pop_seams_randomize",
                                    "tab_group": "pop_left",
                                    "nav_ordinal": 1,
                                    "size": 40,
                                    "label": "$pop_seams_randomize"
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "component": "panel",
                            "id": "pop_view",
                            "style": "panel",
                            "tab_group": "pop_view",
                            "nav_ordinal": 0,
                            "pad": 10,
                            "aspect": 1.0,
                            "children": [
                              {
                                "component": "rtt",
                                "id": "pop_view_rtt",
                                "style": "rtt_holder",
                                "grow": 1.0,
                                "source": "populous_globe"
                              }
                            ]
                          },
                          {
                            "component": "panel",
                            "id": "pop_right",
                            "style": "panel",
                            "tab_group": "pop_right",
                            "nav_ordinal": 0,
                            "pad": 10,
                            "grow": 0.7,
                            "children": [
                              {
                                "component": "cell",
                                "visible_bind": "shown_p0_t0",
                                "grow": 1.0,
                                "gap": 8,
                                "children": [
                                  {
                                    "component": "row",
                                    "size": 22,
                                    "gap": 8,
                                    "children": [
                                      {
                                        "component": "text",
                                        "text": "$pop_stat_hexes",
                                        "text_size": 11,
                                        "font": "label",
                                        "color": "panel.stat_label",
                                        "grow": 1.0
                                      },
                                      {
                                        "component": "text",
                                        "text_bind": "pop_hexes",
                                        "text_size": 15,
                                        "font": "label",
                                        "color": "panel.stat_value",
                                        "align": "right",
                                        "size": 112
                                      }
                                    ]
                                  },
                                  {
                                    "component": "row",
                                    "size": 22,
                                    "gap": 8,
                                    "children": [
                                      {
                                        "component": "text",
                                        "text": "$pop_stat_diameter",
                                        "text_size": 11,
                                        "font": "label",
                                        "color": "panel.stat_label",
                                        "grow": 1.0
                                      },
                                      {
                                        "component": "text",
                                        "text_bind": "pop_diameter",
                                        "text_size": 15,
                                        "font": "label",
                                        "color": "panel.stat_value",
                                        "align": "right",
                                        "size": 112
                                      }
                                    ]
                                  },
                                  {
                                    "component": "row",
                                    "size": 22,
                                    "gap": 8,
                                    "children": [
                                      {
                                        "component": "text",
                                        "text": "$pop_stat_tile",
                                        "text_size": 11,
                                        "font": "label",
                                        "color": "panel.stat_label",
                                        "grow": 1.0
                                      },
                                      {
                                        "component": "text",
                                        "text_bind": "pop_tile",
                                        "text_size": 15,
                                        "font": "label",
                                        "color": "panel.stat_value",
                                        "align": "right",
                                        "size": 112
                                      }
                                    ]
                                  }
                                ]
                              },
                              {
                                "component": "cell",
                                "visible_bind": "shown_p0_t1",
                                "grow": 1.0,
                                "children": [
                                  {
                                    "component": "text",
                                    "text": "$ui_pane_empty"
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "component": "rune_corners",
            "style": "settings.runes",
            "anchor": "top_left",
            "width_frac": 1.0,
            "height_frac": 1.0
          }
        ]
      }
    ]
  },

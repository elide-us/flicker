{
  "_comment": "Populous bench SCENE DEFINITION (201F4F51 template-free). Same form as ClickTrainer/SolarBirth: a behaviour + a tree of primitive component KINDS + exits, authored as data. The bench owns + loads its own scene file (the shell manifest is for shell scenes); populous.lua orchestrates + the globe draws in the rtt pane. Retires the invented populous.tree.json (1F151933).",
  "behaviour": "populous",
  "params": {},
  "tree": {
    "component": "screen",
    "id": "populous",
    "on_menu": "pause_open",
    "on_page_next": "page_next",
    "on_page_prev": "page_prev",
    "on_tab_next": "tab_next",
    "on_tab_prev": "tab_prev",
    "children": [
      {
        "component": "stack",
        "style": "window",
        "runes": true,
        "anchor": "top_left",
        "width_frac": 1.0,
        "height_frac": 1.0,
        "children": [
          {
            "component": "cell",
            "anchor": "top_left",
            "width_frac": 1.0,
            "height_frac": 1.0,
            "pad": 30,
            "children": [
              {
                "component": "paged_menu",
                "style": "paged_menu.frame",
                "pad": 40,
                "grow": 1.0,
                "children": [
                  {
                    "component": "tabs",
                    "id": "paged_pages",
                    "bind": "page",
                    "next_action": "page_next",
                    "prev_action": "page_prev",
                    "grow": 1.0,
                    "gap": 8,
                    "tab_active": "paged_menu.page_active",
                    "tab_idle": "paged_menu.page_idle",
                    "children": [
                      {
                        "component": "option",
                        "value": 0,
                        "label": "$pop_page_world"
                      }
                    ]
                  },
                  {
                    "component": "pill_toggle",
                    "id": "paged_tabs",
                    "bind": "tab",
                    "next_action": "tab_next",
                    "prev_action": "tab_prev",
                    "size": 520,
                    "style": "paged_menu.tab_track",
                    "tab_active": "paged_menu.tab_active",
                    "tab_idle": "paged_menu.tab_idle",
                    "children": [
                      {
                        "component": "option",
                        "value": 0,
                        "label": "$pop_tab_map"
                      },
                      {
                        "component": "option",
                        "value": 1,
                        "label": "$pop_tab_seams"
                      }
                    ]
                  },
                  {
                    "component": "cell",
                    "style": "window",
                    "grow": 1.0,
                    "pad": 30,
                    "children": [
                      {
                        "component": "row",
                        "grow": 1.0,
                        "gap": 10,
                        "children": [
                          {
                            "component": "panel",
                            "id": "pop_left",
                            "style": "panel",
                            "nav_ordinal": 1,
                            "pad": 10,
                            "grow": 0.7,
                            "children": [
                              {
                                "component": "cell",
                                "visible_bind": "shown_p0_t0",
                                "grow": 1.0,
                                "children": [
                                  {
                                    "component": "slider",
                                    "id": "pop_freq",
                                    "style": "slider",
                                    "bind": "pop_freq",
                                    "label": "$pop_size",
                                    "vertical": true,
                                    "min": 48,
                                    "max": 120,
                                    "step": 1,
                                    "step_coarse": 10,
                                    "decimals": 0,
                                    "slider_h": 10,
                                    "value_w": 44,
                                    "grow": 1.0,
                                    "tab_group": "pop_left",
                                    "nav_ordinal": 1
                                  }
                                ]
                              },
                              {
                                "component": "cell",
                                "visible_bind": "shown_p0_t1",
                                "grow": 1.0,
                                "children": [
                                  {
                                    "component": "button",
                                    "action": "pop_seams_randomize",
                                    "tab_group": "pop_left",
                                    "nav_ordinal": 1,
                                    "size_class": "md",
                                    "label": "$pop_seams_randomize"
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "component": "panel",
                            "id": "pop_view",
                            "style": "panel",
                            "pane": true,
                            "nav_ordinal": 2,
                            "pad": 10,
                            "aspect": 1.0,
                            "children": [
                              {
                                "component": "rtt",
                                "id": "pop_view_rtt",
                                "style": "rtt_holder",
                                "grow": 1.0,
                                "source": "populous_globe"
                              }
                            ]
                          },
                          {
                            "component": "panel",
                            "id": "pop_right",
                            "style": "panel",
                            "pane": true,
                            "nav_ordinal": 3,
                            "pad": 10,
                            "grow": 0.7,
                            "children": [
                              {
                                "component": "cell",
                                "visible_bind": "shown_p0_t0",
                                "grow": 1.0,
                                "gap": 8,
                                "children": [
                                  {
                                    "component": "row",
                                    "size": 22,
                                    "gap": 8,
                                    "children": [
                                      {
                                        "component": "text",
                                        "text": "$pop_stat_hexes",
                                        "text_size": 11,
                                        "font": "label",
                                        "color": "panel.stat_label",
                                        "grow": 1.0
                                      },
                                      {
                                        "component": "text",
                                        "text_bind": "pop_hexes",
                                        "text_size": 15,
                                        "font": "label",
                                        "color": "panel.stat_value",
                                        "align": "right",
                                        "size": 112
                                      }
                                    ]
                                  },
                                  {
                                    "component": "row",
                                    "size": 22,
                                    "gap": 8,
                                    "children": [
                                      {
                                        "component": "text",
                                        "text": "$pop_stat_diameter",
                                        "text_size": 11,
                                        "font": "label",
                                        "color": "panel.stat_label",
                                        "grow": 1.0
                                      },
                                      {
                                        "component": "text",
                                        "text_bind": "pop_diameter",
                                        "text_size": 15,
                                        "font": "label",
                                        "color": "panel.stat_value",
                                        "align": "right",
                                        "size": 112
                                      }
                                    ]
                                  },
                                  {
                                    "component": "row",
                                    "size": 22,
                                    "gap": 8,
                                    "children": [
                                      {
                                        "component": "text",
                                        "text": "$pop_stat_tile",
                                        "text_size": 11,
                                        "font": "label",
                                        "color": "panel.stat_label",
                                        "grow": 1.0
                                      },
                                      {
                                        "component": "text",
                                        "text_bind": "pop_tile",
                                        "text_size": 15,
                                        "font": "label",
                                        "color": "panel.stat_value",
                                        "align": "right",
                                        "size": 112
                                      }
                                    ]
                                  }
                                ]
                              },
                              {
                                "component": "cell",
                                "visible_bind": "shown_p0_t1",
                                "grow": 1.0,
                                "children": [
                                  {
                                    "component": "text",
                                    "text": "$ui_pane_empty"
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "exits": {},
  "styles": {
    "paged_menu": {
      "frame": {
        "fill_top": "$surface_top",
        "fill_bot": "$stage_void",
        "border": "$edge2",
        "border_w": 1,
        "radius": 6
      },
      "hint": {
        "fill_top": "$stone_btn_hi",
        "fill_bot": "$stone_btn",
        "border": "$edge4",
        "border_w": 1,
        "radius": 3
      },
      "eyebrow": "$bronze_dim",
      "title": "$ink_bright",
      "rule": "$seam",
      "page_active": {
        "fill_top": [
          0,
          0,
          0,
          0
        ],
        "fill_bot": [
          0,
          0,
          0,
          0
        ],
        "border": [
          0,
          0,
          0,
          0
        ],
        "border_w": 0,
        "radius": 0,
        "label": "$ink_bright",
        "label_size": 15,
        "underline": "$rune_glow_hi",
        "underline_w": 2
      },
      "page_idle": {
        "fill_top": [
          0,
          0,
          0,
          0
        ],
        "fill_bot": [
          0,
          0,
          0,
          0
        ],
        "border": [
          0,
          0,
          0,
          0
        ],
        "border_w": 0,
        "radius": 0,
        "label": "$dim",
        "label_size": 15
      },
      "tab_track": {
        "fill_top": "$well_top",
        "fill_bot": "$well_bot",
        "border": "$edge3",
        "border_w": 1,
        "radius": 14
      },
      "tab_active": {
        "fill_top": "$sap_base",
        "fill_bot": "$sap_base_lo",
        "border": "$sap_border",
        "border_w": 1,
        "radius": 12,
        "label": "$ink_sapphire"
      },
      "tab_idle": {
        "fill_top": [
          0,
          0,
          0,
          0
        ],
        "fill_bot": [
          0,
          0,
          0,
          0
        ],
        "border": [
          0,
          0,
          0,
          0
        ],
        "border_w": 0,
        "radius": 12,
        "label": "$dim"
      },
      "group_eyebrow": "$bronze",
      "well": {
        "fill_top": "$well_top",
        "fill_bot": "$well_bot",
        "border": "$edge2",
        "border_w": 1,
        "radius": 4
      },
      "row_label": "$dim_soft",
      "row_label_focus": "$ink_bright",
      "row_seam": "$seam",
      "row_focus": {
        "fill_top": "$accent_wash",
        "fill_bot": [
          0,
          0,
          0,
          0
        ],
        "border": [
          0,
          0,
          0,
          0
        ],
        "border_w": 0,
        "radius": 0
      },
      "legend_label": "$dim",
      "legend_hint": "$faint"
    },
    "pad_glyphs": {
      "tex": 2,
      "cols": 4,
      "rows": 4,
      "color": "$bronze",
      "flash": "$rune_glow_hi",
      "cells": {
        "lt": 0,
        "rt": 1,
        "lb": 2,
        "rb": 3,
        "a": 4,
        "b": 5,
        "x": 6,
        "y": 7,
        "menu": 8,
        "view": 9,
        "dpad": 10,
        "dpad_up": 11,
        "dpad_down": 12,
        "dpad_left": 13,
        "dpad_right": 14,
        "stick": 15
      }
    },
    "rtt_holder": {
      "_comment": "The framed RTT HOLDER the `rtt_panel` proto defaults to, and every bench's RTT slot styles against — the template-tier namespace for an offscreen-view slot's chrome (replaced the per-scene assetpipeline holder block, same values).",
      "fill_top": "$well_top",
      "fill_bot": "$well_bot",
      "border": "$edge2",
      "border_w": 1,
      "radius": 4,
      "inset": 6
    },
    "slider": {
      "track": "$well",
      "fill": "$sap_base",
      "fill_hi": "$sap_border",
      "handle": "$sap_border",
      "handle_w": 14,
      "focus_track": "$well",
      "focus_fill": "$sap_hover",
      "focus_label": "$rune_glow_hi",
      "value_color": "$dim",
      "label_size": 13,
      "value_size": 12
    },
    "panel": {
      "resting": {
        "fill": "$panel_bg",
        "border": "$edge2",
        "border_w": 1,
        "radius": 3
      },
      "focused": {
        "fill": "$panel_bg",
        "border": "$sap_border",
        "border_w": 2,
        "radius": 3
      },
      "empty": "$dim",
      "stat_label": "$dim",
      "stat_value": "$ink_bright"
    },
    "window": {
      "w": 1180,
      "h": 726,
      "min_margin": 32,
      "radius": 4,
      "fill_top": "$stone3",
      "fill_bot": "$stone1",
      "border": "$edge2",
      "shadow": "$shadow",
      "shadow_dy": 18,
      "shadow_feather": 46,
      "shadow_grow": 4
    }
  }
}

                "action": "confirm_discard",
                "label": "$set_discard",
                "size": 46,
                "label_size": 14,
                "variant": "danger"
              },
              {
                "component": "button",
                "action": "confirm_cancel",
                "label": "$set_cancel_2",
                "size": 46,
                "label_size": 14,
                "variant": "secondary"
              }
            ]
          }
        ]
      },
      {
        "component": "cell",
        "visible_bind": "restore_note",
        "anchor": "top_left",
        "width_frac": 1.0,
        "height_frac": 1.0,
        "style": "screens.pause",
        "children": [
          {
            "component": "popup_panel",
            "title": "$set_defaults_restored",
            "title_size": 26,
            "panel_style": "modal.panel",
            "anchor": "center",
            "layer": 2,
            "children": [
              {
                "component": "text",
                "text": "$set_all_settings_have_been_reset_to_their_de",
                "size": 44,
                "text_size": 15,
                "color": "settings.row.name_color",
                "font": "body",
                "align": "center"
              },
              {
                "component": "button",
                "action": "restore_ok",
                "label": "$set_ok",
                "size": 46,
                "label_size": 14,
                "variant": "primary"
              }
            ]
          }
        ]
      }
    ]
  }
}

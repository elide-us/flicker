      "video": {
        "groups": [
          {
            "name": "$set_display",
            "rows": [
              {
                "id": "display_mode",
                "kind": "dropdown",
                "name": "$set_display_mode",
                "desc": "$set_how_the_game_fills_your_screen",
                "options": [
                  "$set_windowed",
                  "$set_borderless_window",
                  "$set_fullscreen"
                ],
                "wired": true
              },
              {
                "id": "resolution",
                "kind": "dropdown",
                "name": "$set_resolution",
                "desc": "$set_rendering_resolution_of_the_viewport",
                "options": [
                  "1280 × 720",
                  "1600 × 900",
                  "1920 × 1080",
                  "2560 × 1440",
                  "3440 × 1440",
                  "3840 × 2160"
                ],
                "wired": true
              },
              {
                "id": "quality",
                "kind": "segment",
                "name": "$set_graphics_quality",
                "desc": "$set_master_preset_for_all_render_features",
                "options": [
                  "$set_low",
                  "$set_medium",
                  "$set_high",
                  "$set_ultra"
                ],
                "wired": true
              }
            ]
          },
          {
            "name": "$set_performance",
            "rows": [
              {
                "id": "vsync",

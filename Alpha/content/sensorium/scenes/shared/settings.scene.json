        "title_color": "$ink_bright",
        "seam": "$seam",
        "scrollbar": "$bronze_dim"
      },
      "footer": {
        "h": 58,
        "pad_x": 34,
        "seam": "$seam",
        "restore": "$set_restore_defaults",
        "restore_color": "$muted",
        "restore_hover": "$danger_hi",
        "applied": "$settings_applied",
        "applied_color": "$rune_glow_hi",
        "apply": "$set_apply",
        "save_close": "$set_save_and_close"
      },
      "dialogs": {
        "close_title": "$set_unsaved_changes",
        "close_msg": "$set_do_you_want_to_save_your_changes",

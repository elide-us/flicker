            ]
          },
          {
            "name": "$set_image",
            "rows": [
              {
                "id": "fov",
                "kind": "slider",
                "name": "$set_field_of_view",
                "desc": "$set_adventurer_camera_angle_60_120",
                "min": 60,
                "max": 120,
                "default": 90,
                "suffix": "°",
                "wired": false
